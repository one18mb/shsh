#!/usr/bin/env python3
"""send —— 把交互式 shsh 封装成同步（非交互）命令通道，供脚本/Agent 使用。

用法：
  eval "$(send login <name> [session])"   加入会话（后台常驻 shsh，I/O 落文件）
  send logout                             离开会话并结束常驻 shsh
  send [-t 秒] <command>                  阻塞执行，打印自上次返回以来的共享流增量

实现（无 fork / 无守护 / 无额外网络端口）：
  login 后由一个常驻的 `shsh <name> <session>` 进程承载会话，其 stdin/stdout
  绑定到两个 FIFO/文件：
    ~/.shsh/<session>__<name>.in   写入即键入（C2S 方向，原始字节）
    ~/.shsh/<session>__<name>.out  读出即屏幕（S2C 方向，二进制协议帧）
  该常驻 shsh 应由外层后台机制托管，例如：
      shsh <name> <session> < $IN > $OUT
  本脚本的 login 用 nohup+setsid 启动它；游标是 out 文件的字节偏移，天然持久。

返回内容：首次 send 返回从 login 起的全部共享流；之后返回自上次返回结尾到
本次命令结束（RUN_END）的增量（命令回显、提示符、他人键入、命令输出）。
执行权不在自己时阻塞等待别人 `to <name>`，不抢权。

仅标准库。退出码：0 成功；1 运行/超时/协议错误；2 用法/未登录。
"""

import os
import sys
import time
import struct
import subprocess

SOCK_DIR = "/tmp/shsh"
RUN_DIR = os.path.expanduser("~/.shsh")
DEFAULT_SESSION = "session"
DEFAULT_TIMEOUT = float(os.environ.get("SHSH_SEND_TIMEOUT", "300"))

S2C_WELCOME, S2C_OUT, S2C_RUN_BEGIN, S2C_RUN_END, S2C_ROLE, \
    S2C_NOTICE, S2C_LISTRESP, S2C_BYE = 64, 65, 66, 67, 68, 69, 70, 71


def die(msg, code=1):
    sys.stderr.write("send: %s\n" % msg)
    sys.exit(code)


def paths(session, name):
    base = os.path.join(RUN_DIR, "%s__%s" % (session, name))
    return {
        "in": base + ".in",       # FIFO：写入即键入
        "out": base + ".out",     # 文件：S2C 二进制帧流
        "cursor": base + ".cursor",
        "pid": base + ".pid",
        "log": base + ".log",
    }


def read_frame(f):
    """从文件对象读一个完整帧；无更多数据（EOF）返回 None。"""
    hdr = f.read(6)
    if not hdr:
        return None
    if len(hdr) < 6:
        raise ValueError("帧头截断")
    ln, typ = struct.unpack("!IH", hdr)
    pl = f.read(ln)
    if len(pl) < ln:
        raise ValueError("帧体截断")
    return typ, pl


def shsh_running(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def cmd_login(name, session):
    os.makedirs(RUN_DIR, exist_ok=True)
    P = paths(session, name)
    if not os.path.exists(os.path.join(SOCK_DIR, session + ".sock")):
        die("会话 %s 不存在（先启动: shshd %s）" % (session, session))
    if shsh_running(_read_pid(P)):
        _print_exports(name, session)
        sys.stderr.write("已在会话 %s（%s），复用现有连接\n" % (session, name))
        return 0

    for k in ("in",):
        if os.path.exists(P[k]):
            os.remove(P[k])
    os.mkfifo(P["in"])
    for k in ("out",):
        open(P[k], "wb").close()
    open(P["cursor"], "w").write("0")

    # 常驻 shsh：stdin=in(FIFO)，stdout=out(帧流)，stderr=log。
    # setsid+nohup 使其脱离当前终端；由系统 init 托管（外层若有更强的
    # 后台机制，也可直接运行：shsh <name> <session> < $IN > $OUT）。
    log = open(P["log"], "ab")
    in_r = os.open(P["in"], os.O_RDONLY | os.O_NONBLOCK)  # 占位，防 EOF
    cmd = ["shsh", name, session]
    p = subprocess.Popen(cmd, stdin=in_r, stdout=open(P["out"], "wb"),
                         stderr=log, stdin=lambda: None,
                         start_new_session=True, close_fds=True) \
        if False else subprocess.Popen(
            cmd,
            stdin=in_r,
            stdout=open(P["out"], "wb"),
            stderr=log,
            start_new_session=True,
            close_fds=True)
    open(P["pid"], "w").write(str(p.pid))
    # in_r 是给 shsh 的 stdin；父进程保留一个写端 FIFO 以便之后写入不触发 EOF
    in_w = os.open(P["in"], os.O_WRONLY)
    open(P["in"] + ".wfd", "w").close()  # 占位标记（实际 fd 由进程持有）
    _stash_inwrite(P, in_w)
    time.sleep(0.8)
    if not shsh_running(p.pid):
        die("shsh 启动失败，见 %s" % P["log"])
    _print_exports(name, session)
    sys.stderr.write("已加入会话 %s（%s），pid=%d\n" % (session, name, p.pid))
    return 0


# 持有 in FIFO 写端的 fd，存到一个小文件不必要——直接让本进程长期持有不可行
# （login 会退出）。因此用一个独立“保活”进程持有 FIFO 写端，防止 shsh 读到 EOF。
_KEEPALIVE = None


def _stash_inwrite(P, fd):
    global _KEEPALIVE
    # 双 fork 一个极小保活进程，仅持有 FIFO 写端不做事；logout 时随 pid 清理。
    ka = os.fork()
    if ka == 0:
        try:
            os.setsid()
        except OSError:
            pass
        os.close(fd) if False else None
        # 子进程持有 fd（已继承）；再 fork 一次脱离
        gc = os.fork()
        if gc == 0:
            devnull = os.open(os.devnull, os.O_RDWR)
            os.dup2(devnull, 0); os.dup2(devnull, 1); os.dup2(devnull, 2)
            while True:
                time.sleep(3600)
        os._exit(0)
    os.close(fd)  # 父进程不需要；写端由保活孙进程持有


def _read_pid(P):
    try:
        return int(open(P["pid"]).read().strip())
    except (OSError, ValueError):
        return 0


def _print_exports(name, session):
    print("export SHSH_NAME=%s" % name)
    print("export SHSH_SESSION=%s" % session)


def cmd_logout():
    name = os.environ.get("SHSH_NAME")
    session = os.environ.get("SHSH_SESSION") or DEFAULT_SESSION
    if not name:
        die("尚未 login（无 SHSH_NAME）", 2)
    P = paths(session, name)
    pid = _read_pid(P)
    if shsh_running(pid):
        # ^D 让 shsh 离开（经 FIFO 写入）
        try:
            w = os.open(P["in"], os.O_WRONLY)
            os.write(w, b"\x04")
            os.close(w)
        except OSError:
            pass
        time.sleep(0.5)
        if shsh_running(pid):
            import signal
            os.kill(pid, signal.SIGTERM)
            time.sleep(0.3)
    # 杀掉持有 FIFO 写端的保活进程（同会话组名匹配）
    subprocess.run(["pkill", "-f", "shsh__%s__keepalive" % name])
    for k in ("in", "out", "cursor", "pid", "log", "in.wfd"):
        try:
            os.remove(P[k])
        except OSError:
            pass
    sys.stderr.write("已离开会话 %s（%s）\n" % (session, name))
    print("unset SHSH_NAME SHSH_SESSION")
    return 0


def cmd_run(command, timeout):
    name = os.environ.get("SHSH_NAME")
    session = os.environ.get("SHSH_SESSION") or DEFAULT_SESSION
    if not name:
        die("尚未 login，请先: eval \"$(send login <name> [session])\"", 2)
    P = paths(session, name)
    pid = _read_pid(P)
    if not shsh_running(pid):
        die("常驻 shsh 未运行，请重新 login（日志 %s）" % P["log"])

    cur = 0
    try:
        cur = int(open(P["cursor"]).read().strip())
    except (OSError, ValueError):
        cur = 0

    # 发送命令到 in FIFO
    data = command if command.endswith("\n") else command + "\n"
    w = os.open(P["in"], os.O_WRONLY)
    os.write(w, data.encode())
    os.close(w)

    deadline = time.time() + timeout
    self_id = exec_id = None
    saw_begin = False
    out = open(P["out"], "rb")
    out.seek(cur)

    while time.time() < deadline:
        fr = read_frame(out)
        if fr is None:
            if not shsh_running(pid):
                die("常驻 shsh 已退出（日志 %s）" % P["log"])
            time.sleep(0.1)
            continue
        typ, pl = fr
        if typ == S2C_WELCOME:
            self_id, exec_id = struct.unpack("!II", pl[:8])
        elif typ == S2C_ROLE:
            exec_id = struct.unpack("!I", pl[:4])[0]
        elif typ == S2C_OUT:
            sys.stdout.buffer.write(pl)
        elif typ == S2C_RUN_BEGIN:
            saw_begin = True
        elif typ == S2C_RUN_END:
            if saw_begin:
                end = out.tell()
                sys.stdout.buffer.flush()
                open(P["cursor"], "w").write(str(end))
                return 0
        elif typ == S2C_BYE:
            reason = pl[1:1 + pl[0]] if pl else b""
            die("会话关闭: %s" % reason.decode(errors="replace"))
    sys.stdout.buffer.flush()
    die("执行超时（%ss）；执行权可能在他人处，请其 `to %s`" % (timeout, name))


def main(argv):
    if len(argv) < 2:
        die("用法: send login <name> [session] | send logout | send [-t 秒] <command>", 2)
    sub = argv[1]
    if sub == "login":
        if len(argv) < 3:
            die("用法: send login <name> [session]", 2)
        return cmd_login(argv[2], argv[3] if len(argv) > 3 else DEFAULT_SESSION)
    if sub == "logout":
        return cmd_logout()
    timeout = DEFAULT_TIMEOUT
    args = argv[1:]
    if sub == "-t":
        if len(argv) < 4:
            die("用法: send -t <秒> <command>", 2)
        timeout = float(argv[2])
        args = argv[3:]
    command = " ".join(args)
    if not command.strip():
        die("空命令", 2)
    return cmd_run(command, timeout)


if __name__ == "__main__":
    sys.exit(main(main_argv=sys.argv) if False else main(sys.argv))
